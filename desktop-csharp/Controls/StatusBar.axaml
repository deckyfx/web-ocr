<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WebOcrDesktop.ViewModels"
             x:Class="WebOcrDesktop.Controls.StatusBar"
             x:DataType="vm:MainViewModel">

    <Border Padding="12,8" Background="{DynamicResource Surface0Brush}">
        <Grid ColumnDefinitions="Auto,*">

            <!-- Spinner shown while busy -->
            <Panel Grid.Column="0" Width="18" Height="18"
                   IsVisible="{Binding Status,
                     Converter={x:Static vm:StatusToBoolConverter.IsBusy}}"
                   Margin="0,0,8,0">
                <!-- Simple rotating arc via animation -->
                <Ellipse Width="16" Height="16"
                         Stroke="{DynamicResource BlueBrush}"
                         StrokeThickness="2.5"
                         StrokeDashArray="25,5">
                    <Ellipse.Styles>
                        <Style Selector="Ellipse">
                            <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="RenderTransform" Value="rotate(0deg)" />
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="RenderTransform" Value="rotate(360deg)" />
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Ellipse.Styles>
                </Ellipse>
            </Panel>

            <!-- Status text -->
            <TextBlock Grid.Column="1"
                       Text="{Binding StatusText}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{Binding Status,
                         Converter={x:Static vm:StatusToColorConverter.Instance}}"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Border>
</UserControl>
