# Server
PORT=3579

# OCR models directory (needs: encoder_model.onnx, decoder_model.onnx, vocab.txt)
# Download from https://huggingface.co/mayocream/manga-ocr-onnx
OCR_MODELS_DIR=./models/ocr

# Translation models directory (needs: encoder_model.onnx, decoder_model.onnx, source.spm, target.spm, vocab.json)
# Download from https://huggingface.co/Xenova/opus-mt-ja-en
TRANSLATE_MODELS_DIR=./models/translate

# Database
DATABASE_URL=ocr.db

# DeepL Translation API (optional — enables the DeepL engine)
# Free-tier keys end in :fx  ��  https://www.deepl.com/pro-api
# DEEPL_API_KEY=
