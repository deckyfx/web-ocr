# Server
PORT=3579
# Bind to a Unix socket instead of TCP (useful when running behind nginx or as a microservice).
# When set, PORT is ignored.
# SOCKET_PATH=/tmp/web-ocr.sock

# ── Model source repos (HuggingFace owner/name) ──────────────────────────────
# Change these to swap the underlying model without touching code.
# Dirs default to ./data/models/<name>; set only if you want a non-default path.

# OCR — manga-ocr ONNX (required)
# OCR_MODEL_REPO=mayocream/manga-ocr-onnx
# OCR_MODELS_DIR=./data/models/ocr
# OCR_MODEL_ENABLED=true
# OCR_MODEL_FILES=encoder_model.onnx,decoder_model.onnx,vocab.txt

# Translation — Opus-MT ja→en (required)
# TRANSLATE_MODEL_REPO=Xenova/opus-mt-ja-en
# TRANSLATE_MODELS_DIR=./data/models/translate
# TRANSLATE_MODEL_ENABLED=true
# TRANSLATE_MODEL_FILES=onnx/encoder_model.onnx,onnx/decoder_model.onnx,tokenizer.json

# Inpainting — fill erased text regions (optional, disabled by default)
# Set INPAINT_MODEL_REPO to a HuggingFace repo that exposes model.onnx, e.g.:
#   dreMaz/Animeremove  (anime/manga LaMa variant)
# INPAINT_MODEL_REPO=
# INPAINT_MODELS_DIR=./data/models/inpaint
# INPAINT_MODEL_ENABLED=false
# INPAINT_MODEL_FILES=model.onnx

# Bubble/text-region detection — YOLO ONNX (optional, disabled by default)
# Set BUBBLE_MODEL_REPO to a HuggingFace repo that exposes model.onnx, e.g.:
#   ogkalu2/comic-speech-bubble-detector  (YOLOv8 export)
# BUBBLE_MODEL_REPO=
# BUBBLE_MODELS_DIR=./data/models/bubble
# BUBBLE_MODEL_ENABLED=false
# BUBBLE_MODEL_FILES=model.onnx

# ── Dictionary ────────────────────────────────────────────────────────────────
# DICT_DIR=./data/models/jdict

# ── Database (SQLite) ─────────────────────────────────────────────────────────
# DATABASE_URL=./data/ocr.db

# ── DeepL Translation API (optional — enables the DeepL engine) ───────────────
# Free-tier keys end in :fx  →  https://www.deepl.com/pro-api
# DEEPL_API_KEY=
