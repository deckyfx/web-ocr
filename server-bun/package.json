{
  "name": "web-ocr-server-bun",
  "version": "0.1.0",
  "description": "web-ocr server rewritten in Bun (Elysia + Drizzle + onnxruntime-node)",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "start": "./app",
    "build": "bun run typecheck && bun run build.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/eden": "^1.4.9",
    "@elysiajs/static": "^1.4.10",
    "@huggingface/hub": "^2.15.0",
    "@tanstack/react-query": "^5.101.4",
    "deepl-node": "^1.28.0",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.29",
    "lucide-react": "^1.33.0",
    "onnxruntime-node": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "sharp": "^0.35.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "bun-plugin-tailwind": "^0.1.2",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
